{
  "name": "educatefy-backend",
  "version": "1.0.0",
  "description": "A web application for online learning.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "npx tsc && cp src/utils/GeoLite2-Country.mmdb dist/utils/",
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "gql-codegen": "graphql-codegen",
    "create-migration": "cd src/db && npx knex migrate:make",
    "list-migrations": "cd src/db && npx knex migrate:list",
    "migrate": "cd src/db && npx knex migrate:latest",
    "update-db-types": "npx tsx ./src/scripts/generateDbTypes.ts",
    "generate-loaders": "npx tsx ./src/scripts/generateLoaders.ts",
    "generate-custom-loader": "npx tsx ./src/scripts/generateCustomLoader.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@envelop/disable-introspection": "^9.1.1",
    "@escape.tech/graphql-armor": "^3.2.0",
    "@supabase/supabase-js": "^2.105.1",
    "axios": "^1.16.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dataloader": "^2.2.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "graphql": "^16.13.2",
    "graphql-type-json": "^0.3.2",
    "graphql-yoga": "^5.21.0",
    "helmet": "^8.1.0",
    "jsdom": "^29.1.1",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.2.10",
    "lodash": "^4.18.1",
    "maxmind": "^5.0.6",
    "multer": "^2.1.1",
    "nanoid": "^5.1.11",
    "openid-client": "^6.8.4",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "ua-parser-js": "^2.0.10"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.0.0",
    "@graphql-codegen/typescript": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.1",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.24",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/pino": "^7.0.4",
    "@types/ua-parser-js": "^0.7.39",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "eslint": "^8",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^9",
    "eslint-plugin-import": "^2",
    "eslint-plugin-jest": "^27",
    "eslint-plugin-n": "^16",
    "eslint-plugin-prettier": "^5",
    "eslint-plugin-promise": "^6",
    "knex-types": "^0.5.0",
    "prettier": "^3.8.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
